# EduInsight AI — Environment Configuration Example
# Copy this file to .env and configure your variables

# Backend REST API URL (Optional for local development, defaults to /api proxy on http://127.0.0.1:5000)
VITE_API_URL=http://127.0.0.1:5000

# Supabase Cloud Project Configuration (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
